    "notifications.border": "#2B4558",
    "notifications.foreground": "#DCE7EB",
    "quickInput.background": "#111E2A",
    "quickInput.foreground": "#DCE7EB",
    "quickInputList.focusBackground": "#263E50",
    "quickInputList.focusForeground": "#FFF8EC",
    "gitDecoration.addedResourceForeground": "#73C99B",
    "gitDecoration.modifiedResourceForeground": "#67C9E8",
    "gitDecoration.deletedResourceForeground": "#E85B55",
    "gitDecoration.renamedResourceForeground": "#D78BE8",
    "gitDecoration.untrackedResourceForeground": "#83C9A5",
    "gitDecoration.ignoredResourceForeground": "#536877",
    "diffEditor.insertedTextBackground": "#3A8D6533",
    "diffEditor.removedTextBackground": "#D34E4933",
    "diffEditor.insertedLineBackground": "#3A8D6518",
    "diffEditor.removedLineBackground": "#D34E4918",
    "minimap.findMatchHighlight": "#F58A4B",
    "minimap.selectionHighlight": "#67C9E877",
    "minimap.errorHighlight": "#FF6B63",
    "minimap.warningHighlight": "#E7C66B"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#607585", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#91D6B2" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#E7C66B" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#F0783A" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#72CBE8" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"],
      "settings": { "foreground": "#F0E8D8" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#C9D7DE" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#E8A071", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#F0783A" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#72CBE8" }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"],
      "settings": { "foreground": "#8EABB9" }
    },
    {
      "scope": ["punctuation.definition.string", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#73B98F" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFF8EC", "background": "#B83D3D" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#F0783A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F0E8D8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#A8C6D3", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#91D6B2" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#67C9E8", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#F0E8D8",
    "type": "#F0E8D8",
    "class": "#F0E8D8",
    "enum": "#F0E8D8",
    "interface": "#A8D6E2",
    "struct": "#F0E8D8",
    "typeParameter": "#A8D6E2",
    "parameter": { "foreground": "#E8A071", "italic": true },
    "variable": "#C9D7DE",
    "property": "#B9D6DF",
    "enumMember": "#E7C66B",
    "function": "#72CBE8",
    "method": "#72CBE8",
    "macro": "#D78BE8",
    "keyword": "#F0783A",
    "comment": { "foreground": "#607585", "italic": true },
    "string": "#91D6B2",
    "number": "#E7C66B",
    "regexp": "#83C9D0",
    "operator": "#8EABB9",
    "decorator": "#D78BE8"
  }
}
