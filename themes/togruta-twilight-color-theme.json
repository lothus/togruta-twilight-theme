    "peekViewEditor.background": "#0B1620",
    "peekViewResult.background": "#0D1924",
    "peekViewResult.selectionBackground": "#263E50",
    "peekViewTitle.background": "#132330",
    "panel.background": "#0B1620",
    "panel.border": "#294152",
    "panelTitle.activeBorder": "#E86F2C",
    "panelTitle.activeForeground": "#F4EEE2",
    "panelTitle.inactiveForeground": "#708493",
